# Copy to .env.local for local development. Never commit real .env files.
# On Vercel, set these in Project → Settings → Environment Variables.

# ---- Sanity (content management) ------------------------------------------
# Project ID and dataset name from manage.sanity.io → your project → API.
# Not secret: required for the browser to talk to Sanity's API, same as any
# public API endpoint identifier.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: Sanity API version (date-based). Defaults to 2025-01-01 if unset.
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only token with "Viewer" access (read, including drafts). Used to
# show draft content to editors in Draft Mode / Presentation preview.
# NEVER prefix this with NEXT_PUBLIC_ — it must never reach the browser.
# Create it at manage.sanity.io → your project → API → Tokens.
SANITY_API_READ_TOKEN=

# Server-only token with "Editor" access (read + write). Used by
# `npm run sanity:migrate` (run from your own machine or CI), AND by the
# deployed website's /api/candidaturas route to save job-application
# submissions (name, email, CV) as they come in. Because the live site now
# depends on it, this DOES need to be set in Vercel's Production environment
# variables — unlike before, it can no longer be kept local-only. Consider
# creating a token dedicated to this route (separate from the one used for
# local migrations) so it can be rotated independently.
SANITY_API_WRITE_TOKEN=

# ---- Email notifications for job applications ------------------------------
# When someone submits the CV application form, it's always saved in Sanity
# (Studio → Candidaturas recibidas) regardless of these — but to ALSO get an
# email the moment it happens, configure all three below using Resend
# (resend.com has a free tier). Leave any of them empty and the app silently
# skips sending the email (logs a warning) without failing the candidate's
# submission.

# API key from resend.com → API Keys. Server-only, never exposed to the browser.
RESEND_API_KEY=

# Where the notification email is sent — the inbox that should receive new candidaturas.
CANDIDATURE_NOTIFICATION_EMAIL=olteniaconducciones@yahoo.es

# The "From" address Resend sends as. Until you verify your own domain in Resend,
# you can only use their sandbox sender (e.g. "Oltenia <onboarding@resend.dev>"),
# which in sandbox mode can only deliver to the email address of the Resend
# account itself — not to CANDIDATURE_NOTIFICATION_EMAIL unless that's the same
# address. Verify a real domain in Resend to send to any inbox.
CANDIDATURE_NOTIFICATION_FROM=

# ---- Production domain and indexing ----------------------------------------

# Final production origin, https only, no trailing path (e.g. https://<dominio-definitivo>).
# Used for canonical URLs, Open Graph URLs, sitemap.xml and structured data.
# Leave empty until the domain is purchased and connected. Localhost and *.vercel.app are rejected.
# Set it ONLY for the Production environment on Vercel.
NEXT_PUBLIC_SITE_URL=

# "true" allows search engines to index the site. Anything else keeps every page noindex,
# robots.txt disallowed and an X-Robots-Tag: noindex header.
# Indexing also requires the "Contenido aprobado para publicar" toggle in Sanity (siteSettings)
# and a valid NEXT_PUBLIC_SITE_URL, and is always disabled on Vercel Preview/Development deployments
# (VERCEL_ENV).
# Set it ONLY for the Production environment on Vercel, and only at launch.
SITE_INDEXING=false
