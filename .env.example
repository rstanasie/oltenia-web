# Copy to .env.local for local development. Never commit real .env files.
# On Vercel, set these in Project → Settings → Environment Variables.

# ---- Sanity (content management) ------------------------------------------
# Project ID and dataset name from manage.sanity.io → your project → API.
# Not secret: required for the browser to talk to Sanity's API, same as any
# public API endpoint identifier.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: Sanity API version (date-based). Defaults to 2025-01-01 if unset.
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only token with "Viewer" access (read, including drafts). Used to
# show draft content to editors in Draft Mode / Presentation preview.
# NEVER prefix this with NEXT_PUBLIC_ — it must never reach the browser.
# Create it at manage.sanity.io → your project → API → Tokens.
SANITY_API_READ_TOKEN=

# Server-only token with "Editor" access (read + write). Only used by
# `npm run sanity:migrate`, run from your own machine or CI — never by the
# deployed website. Keep it out of Vercel's runtime environment variables
# entirely if you only ever run the migration locally.
SANITY_API_WRITE_TOKEN=

# ---- Production domain and indexing ----------------------------------------

# Final production origin, https only, no trailing path (e.g. https://<dominio-definitivo>).
# Used for canonical URLs, Open Graph URLs, sitemap.xml and structured data.
# Leave empty until the domain is purchased and connected. Localhost and *.vercel.app are rejected.
# Set it ONLY for the Production environment on Vercel.
NEXT_PUBLIC_SITE_URL=

# "true" allows search engines to index the site. Anything else keeps every page noindex,
# robots.txt disallowed and an X-Robots-Tag: noindex header.
# Indexing also requires the "Contenido aprobado para publicar" toggle in Sanity (siteSettings)
# and a valid NEXT_PUBLIC_SITE_URL, and is always disabled on Vercel Preview/Development deployments
# (VERCEL_ENV).
# Set it ONLY for the Production environment on Vercel, and only at launch.
SITE_INDEXING=false
