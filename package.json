    "check": "npm run lint && npm run typecheck && npm run content:check && npm run build"
  },
  "dependencies": {
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.21.0",
    "next": "^16.4.6",
    "next-sanity": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.21.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@next/env": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
