{
  "name": "oltenia-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "tsx scripts/validate-content.ts",
    "content:check:launch": "tsx scripts/validate-content.ts --launch",
